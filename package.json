{
  "name": "template-fe-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "gen:api": "openapi-typescript ../backend/schema.yaml -o src/lib/api-types.ts",
    "cf:build": "NODE_OPTIONS='--max-old-space-size=4096' npx @opennextjs/cloudflare build",
    "cf:preview": "npx wrangler dev",
    "cf:deploy": "npx @opennextjs/cloudflare build && npx wrangler deploy"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^3.5.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@tanstack/query-sync-storage-persister": "^5.62.7",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-query-persist-client": "^5.62.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.14.7",
    "@playwright/test": "^1.49.1",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "openapi-typescript": "^7.4.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "wrangler": "^4.54.0"
  }
}
