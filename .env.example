# =============================================================================
# Frontend template — environment variables
# =============================================================================
# Copy to .env.local (NEVER commit .env.local). For local dev, dummy values
# are enough to boot the server — Auth0 is only called when the user actually
# clicks the login link.
# =============================================================================

# Auth0 (server-side @auth0/nextjs-auth0)
# Generate a secret with: openssl rand -hex 32
AUTH0_SECRET=replace-with-openssl-rand-hex-32
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com
AUTH0_CLIENT_ID=replace-with-auth0-client-id
AUTH0_CLIENT_SECRET=replace-with-auth0-client-secret
AUTH0_AUDIENCE=https://api.example.com

# Backend API base URL (read by src/lib/api-client.ts)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Dev auth bypass — Playwright uses this to skip the Auth0 roundtrip.
# Matches DEV_AUTH_BYPASS=true on the backend.
NEXT_PUBLIC_DEV_AUTH_BYPASS=true
